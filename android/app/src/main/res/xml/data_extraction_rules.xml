<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sms_queue.xml" />
        <!-- Holds the OpenRouter API key; kept out of cloud backup. -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- A direct phone-to-phone move stays on the user's own devices,
             so settings (including the API key) come along. -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sms_queue.xml" />
    </device-transfer>
</data-extraction-rules>
