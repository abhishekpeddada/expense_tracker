<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A framework theme, so the call screen does not inherit the Flutter
         launch theme's splash background or depend on any library. -->
    <style name="InCallTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
